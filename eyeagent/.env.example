# Example .env for EyeAgent
# Keep dotenv for API credentials only. All other settings are controlled via YAML config and CLI flags.

# LLM provider (OpenAI-compatible). Required for calling the model.
OPENAI_API_KEY=sk-REPLACE_ME

# Optional: if using a compatible provider (leave unset to use defaults from config)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Note:
# - Do NOT export EYEAGENT_* variables. Use `eyeagent/config/eyeagent.yml` instead.
# - Runtime toggles (backend/profile) are chosen from the config or CLI flags,
#   e.g. `uv run eyeagent-ui --backend profile`.
